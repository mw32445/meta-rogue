@@ -17,6 +17,33 @@
 void oracle_stuck(void);	/* oracle: hooks.c */
 
 /*
+ * maze_door:
+ *	FIX 8: conn() picks a door among squares 1..n of a row (dy 0, dx 1)
+ *	or column (dy 1, dx 0) of a room starting at (y, x), and for a maze
+ *	it waits for a passage square there.  A maze's cells are at even
+ *	offsets from its corner; a row or column between two rows or
+ *	columns of cells has a passage square only where the maze links
+ *	them, and may have none in range: the loop never ended.  Then dig
+ *	one at an even offset, which links two cells.
+ */
+static void
+maze_door(struct room *rp, int y, int x, int dy, int dx, int n)
+{
+    int i, k;
+    coord c;
+
+    if (!(rp->r_flags & ISMAZE))
+	return;
+    for (i = 1; i <= n; i++)
+	if (flat(y + i * dy, x + i * dx) & F_PASS)
+	    return;
+    k = 2 * (rnd(n / 2) + 1);
+    c.y = y + k * dy;
+    c.x = x + k * dx;
+    putpass(&c);
+}
+
+/*
  * do_passages:
  *	Draw all the passages on a level.
  */
