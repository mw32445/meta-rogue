; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rogue"
config/description="Rogue 5.4.4 (Michael Toy, Ken Arnold, Glenn Wichman), ported 1:1 to Godot."
config/features=PackedStringArray("4.7")
run/main_scene="res://main.tscn"
run/low_processor_mode=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/redundant_await=2
gdscript/warnings/shadowed_global_identifier=2
